# ==============================================================================
# Configuración de tn5250 para IBM i / AS400
# Documentación: man 5 tn5250rc
# ==============================================================================
# Modelos de Terminal disponibles para env.TERM:
#
#   IBM-3179-2   : 24x80, Color (Soporta los 7 colores estándar de IBM 5250)
#   IBM-3180-2   : 24x80 o 27x132, Monocromo (Fósforo verde/ámbar) [POR DEFECTO]
#   IBM-3196-A1  : 24x80, Monocromo estándar
#   IBM-3477-FC  : 24x80 o 27x132, Color (Soporta 132 columnas y colores)
#   IBM-3477-FG  : 24x80 o 27x132, Monocromo (132 columnas)
#   IBM-5292-2   : 24x80, Color clásico
#   IBM-5251-11  : 24x80, Monocromo histórico (el terminal original)
# ==============================================================================

gn73 {
    host = 192.168.73.154

    # --------------------------------------------------------------------------
    # MODELO DE TERMINAL (env.TERM)
    # --------------------------------------------------------------------------
    env.TERM = IBM-3180-2
    # env.TERM = IBM-3477-FC    # Descomentar para Color + soporte de 132 columnas
    # env.TERM = IBM-3179-2     # Descomentar para Color estándar (80x24)

    # Mapa de caracteres (CCSID 284: Español / España y Latinoamérica)
    map = 284

    # Mostrar subrayados en los campos de entrada
    +underscores
}
