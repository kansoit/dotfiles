# ==============================================================================
# Configuración de tn5250 para IBM i / AS400
# Documentación: man 5 tn5250rc
# NOTA IMPORTANTE: tn5250 requiere que los comentarios '#' comiencen en la columna 0.
# ==============================================================================
# Modelos disponibles para env.TERM:
#   IBM-3180-2   : 24x80 o 27x132, Monocromo (Fósforo verde/ámbar) [ACTIVO]
#   IBM-3477-FC  : 24x80 o 27x132, Color (Soporta 132 columnas y colores)
#   IBM-3179-2   : 24x80, Color estándar
#   IBM-3196-A1  : 24x80, Monocromo estándar
#   IBM-5292-2   : 24x80, Color clásico
#   IBM-5251-11  : 24x80, Monocromo histórico
# ==============================================================================

gn73 {
    host = 192.168.73.154
    env.TERM = IBM-3180-2
    map = 284
    +underscores
}
